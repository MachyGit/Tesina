# ─── Base de datos (XAMPP por defecto) ───────────────────────
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=escuela_db

# ─── JWT ─────────────────────────────────────────────────────
# Cambiá esto por una cadena larga y aleatoria antes de producción
JWT_SECRET=cambia_esto_por_algo_muy_largo_y_random_123!

# ─── Servidor ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Token interno para que el bot se comunique con el backend ─
# Tiene que ser el mismo valor en el .env del bot de Telegram
BOT_SECRET=clave_secreta_compartida_bot_backend

# ─── Mail (formulario de contacto de la página principal) ──────
# Cuenta que despacha los correos. Necesita una "contraseña de aplicación"
# (NO la contraseña normal de Gmail). Se genera en:
# https://myaccount.google.com/apppasswords
MAIL_USER=service.nunez15@gmail.com
MAIL_PASS=contraseña_de_aplicacion_de_16_caracteres

# Casilla de la escuela a la que llegan las consultas del formulario
MAIL_DESTINO=lenunez@escuelasproa.edu.ar

# ─── Campus: enlaces y funciones nuevas ──────────────────────
# URL donde se abre el campus (se usa en los enlaces de los mails).
FRONTEND_URL=http://localhost:3000
# URL que abre el celular del alumno al escanear el QR de asistencia.
# En el celu "localhost" no sirve: poné la IP de la PC, ej. http://192.168.1.50:3000
# FRONTEND_PUBLIC_URL=http://192.168.1.50:3000
# Hora límite de ingreso por turno (después se marca "tarde")
# HORA_INGRESO=08:00
# Zona horaria de los eventos del calendario
TZ_CAMPUS=America/Argentina/Cordoba
# 1 = no envía mails reales: los imprime en la consola del servidor
# MAIL_MODO_PRUEBA=1

# ─── Avisos de autoría a TU Telegram (opcional) ────────────────
# Para que el servidor te avise si alguien toca la firma de autoría, o para
# mandarte un "sigo vivo" por cron (npm run latido). Ver README → "Avisos de autoría".
# Token del bot que te creó @BotFather (puede ser el mismo del bot del campus).
# ALERTA_TG_TOKEN=
# Tu chat_id de Telegram (hablale al bot y fijate tu id, o usá @userinfobot).
# ALERTA_TG_CHAT_ID=
