# ─── Bot de Telegram ─────────────────────────────────────────
# Token que te da @BotFather en Telegram (comando /newbot)
TELEGRAM_TOKEN=pon_aqui_el_token_de_botfather

# ─── Backend del campus ──────────────────────────────────────
API_URL=http://localhost:5000/api
# Tiene que ser IGUAL al BOT_SECRET del .env del backend (carpeta raíz del proyecto)
BOT_SECRET=clave_secreta_compartida_bot_backend

# ─── IA gratuita (alcanza con UNA de las dos) ────────────────
# Principal: Groq — clave gratis en https://console.groq.com/keys
GROQ_API_KEY=
# Respaldo (opcional): Gemini — clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelos (opcional). Vacío = el bot elige solo uno que exista hoy en tu cuenta.
# Útil si querés forzar uno: GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=
GEMINI_MODEL=

# ─── Límites (cuidan la cuota gratuita) ──────────────────────
IA_COOLDOWN_SEG=3
IA_MAX_POR_HORA=20
IA_MAX_POR_DIA_TOTAL=600
MAX_CARACTERES=500
