{
  "expo": {
    "name": "Campus Virtual",
    "slug": "escuela-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a3a6b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ar.edu.escuela.campus"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a3a6b"
      },
      "package": "ar.edu.escuela.campus"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a3a6b"
        }
      ]
    ],
    "scheme": "escuela"
  }
}
